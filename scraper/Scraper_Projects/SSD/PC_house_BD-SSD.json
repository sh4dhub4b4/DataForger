{
  "meta": {
    "name": "PC_house_BD-SSD",
    "url": "https://www.pchouse.com.bd/internal-ssd?limit=500"
  },
  "container": {
    "selector": "div.single-product-item",
    "type": "css"
  },
  "pagination": {
    "type": "next_button",
    "selector": "ul.pagination li a",
    "limit": 10
  },
  "fields": [
    {
      "name": "Title",
      "selector": "div.product-item-info h4 a",
      "attr": "text",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Link",
      "selector": "div.product-item-info h4 a",
      "attr": "href",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Image",
      "selector": "img",
      "attr": "src",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Price",
      "selector": "div.price-info span:first-child",
      "attr": "text",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Status",
      "selector": "button.buy-btn ",
      "attr": "text",
      "filter": "none",
      "formula": ""
    }
  ],
  "output": {
    "filename": "PC_house_BD-SSD",
    "format": "csv"
  }
}