{
  "meta": {
    "name": "PC_house_BD-SSD",
    "url": "https://www.pchouse.com.bd/internal-ssd?limit=50"
  },
  "container": {
    "selector": "div.single-product-item, div.product-item-info",
    "type": "css"
  },
  "pagination": {
    "type": "page_loop",
    "selector": "page",
    "limit": 5
  },
  "fields": [
    {
      "name": "Title",
      "selector": "div.product-item-info h4 a, h4 a",
      "attr": "text",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Link",
      "selector": "div.product-item-info h4 a, h4 a",
      "attr": "href",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Image",
      "selector": "img",
      "attr": "src",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Price",
      "selector": "div.price-info span:first-child, span.price",
      "attr": "text",
      "filter": "number",
      "formula": ""
    },
    {
      "name": "Status",
      "selector": "button.buy-btn",
      "attr": "text",
      "filter": "none",
      "formula": ""
    }
  ],
  "output": {
    "filename": "PC_house_BD-SSD",
    "format": "csv"
  }
}
