{
  "meta": {
    "name": "BinaryLogic-SSD",
    "url": "https://www.binarylogic.com.bd/solid-state-drive"
  },
  "container": {
    "selector": "article.single_product",
    "type": "css"
  },
  "pagination": {
    "type": "page_loop",
    "selector": "",
    "limit": 10
  },
  "fields": [
    {
      "name": "Title",
      "selector": "h4 a",
      "attr": "text",
      "filter": "custom",
      "formula": "trim | replace('|','')"
    },
    {
      "name": "Link",
      "selector": "div.p-item-img a",
      "attr": "href",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Image",
      "selector": "img",
      "attr": "src",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Price",
      "selector": "div.p-item-price span:last-child",
      "attr": "text",
      "filter": "number",
      "formula": ""
    },
    {
      "name": "Status",
      "selector": "span.text-white",
      "attr": "text",
      "filter": "none",
      "formula": ""
    }
  ],
  "output": {
    "filename": "BinaryLogic-SSD",
    "format": "csv"
  }
}