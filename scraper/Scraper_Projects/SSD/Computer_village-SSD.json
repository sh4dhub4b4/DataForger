{
  "meta": {
    "name": "Computer_village-SSD",
    "url": "https://www.computervillage.com.bd/ssd?limit=500"
  },
  "container": {
    "selector": "div.product-thumb",
    "type": "css"
  },
  "pagination": {
    "type": "page_loop",
    "selector": "",
    "limit": 10
  },
  "fields": [
    {
      "name": "Title",
      "selector": "div.name a",
      "attr": "text",
      "filter": "custom",
      "formula": "trim | replace('|','')"
    },
    {
      "name": "Link",
      "selector": "div.name a",
      "attr": "href",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Image",
      "selector": "img",
      "attr": "src",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Price",
      "selector": "span.price-normal",
      "attr": "text",
      "filter": "number",
      "formula": ""
    },
    {
      "name": "Status",
      "selector": "span.price-normal",
      "attr": "text",
      "filter": "custom",
      "formula": "replace('৳', '1') | if_num('In Stock', 'Out Of Stock')"
    }
  ],
  "output": {
    "filename": "Computer_village-SSD",
    "format": "csv"
  }
}