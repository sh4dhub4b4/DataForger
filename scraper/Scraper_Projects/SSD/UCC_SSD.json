{
  "meta": {
    "name": "UCC_SSD",
    "url": "https://www.ucc.com.bd/solid-state-drives?limit=200"
  },
  "container": {
    "selector": "div.product-thumb",
    "type": "css"
  },
  "pagination": {
    "type": "next_button",
    "selector": "ul.pagination li a",
    "limit": 5
  },
  "fields": [
    {
      "name": "Title",
      "selector": "div.name a",
      "attr": "text",
      "filter": "custom",
      "formula": "trim | replace('|','')"
    },
    {
      "name": "Link",
      "selector": "div.name a",
      "attr": "href",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Image",
      "selector": "img",
      "attr": "src",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Price",
      "selector": "div.price div span",
      "attr": "text",
      "filter": "number",
      "formula": ""
    },
    {
      "name": "Status",
      "selector": "span.stat-1 span:nth-child(2)",
      "attr": "text",
      "filter": "custom",
      "formula": "replace('Buy Now','In Stock') | trim"
    }
  ],
  "output": {
    "filename": "UCC_SSD",
    "format": "csv"
  }
}