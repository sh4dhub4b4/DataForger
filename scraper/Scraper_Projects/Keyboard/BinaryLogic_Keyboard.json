{
  "meta": {
    "name": "BinaryLogic_Keyboard",
    "url": "https://www.binarylogic.com.bd/keyboard?limit=500"
  },
  "container": {
    "selector": "article.single_product, div.product-layout",
    "type": "css"
  },
  "pagination": {
    "type": "page_loop",
    "selector": "page",
    "limit": 3
  },
  "fields": [
    {
      "name": "Title",
      "selector": "h4.p-item-name a, h4 a",
      "attr": "text",
      "filter": "custom",
      "formula": "trim | replace('|','')"
    },
    {
      "name": "Link",
      "selector": "div.p-item-img a, h4 a",
      "attr": "href",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Image",
      "selector": "img",
      "attr": "src",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Price",
      "selector": "div.p-item-price span:last-child, span.current_price",
      "attr": "text",
      "filter": "number",
      "formula": ""
    },
    {
      "name": "Status",
      "selector": "span.text-white, div.new-product-badge span",
      "attr": "text",
      "filter": "none",
      "formula": ""
    }
  ]
}