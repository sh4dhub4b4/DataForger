{
  "meta": {
    "name": "Keyboard_startech",
    "url": "https://www.startech.com.bd/accessories/keyboards?limit=90"
  },
  "container": {
    "selector": "div.p-item",
    "type": "css"
  },
  "pagination": {
    "type": "next_button",
    "selector": "ul.pagination li.active + li a",
    "limit": 10
  },
  "fields": [
    {
      "name": "Title",
      "selector": "h4.p-item-name a",
      "attr": "text",
      "filter": "custom",
      "formula": "trim | remove('||')"
    },
    {
      "name": "Link",
      "selector": "h4.p-item-name a",
      "attr": "href",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Image",
      "selector": "div.p-item-img a img",
      "attr": "src",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Price",
      "selector": "div.p-item-price span",
      "attr": "text",
      "filter": "number",
      "formula": ""
    },
    {
      "name": "Status",
      "selector": "div.p-item-price span",
      "attr": "text",
      "filter": "custom",
      "formula": "trim | if_num('In Stock','Out of stock')"
    }
  ],
  "output": {
    "filename": "Keyboard_startech",
    "format": "csv"
  }
}