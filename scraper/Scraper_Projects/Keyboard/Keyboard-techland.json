{
  "meta": {
    "name": "Keyboard-techland",
    "url": "https://www.techlandbd.com/accessories/computer-keyboard"
  },
  "container": {
    "selector": "div.products-list__item, article.products-list__item",
    "type": "css"
  },
  "pagination": {
    "type": "page_loop",
    "selector": "",
    "limit": 45
  },
  "fields": [
    {
      "name": "Title",
      "selector": "a.product-title, h4 a, h2 a",
      "attr": "text",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Link",
      "selector": "a.product-title, h4 a, h2 a",
      "attr": "href",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Image",
      "selector": "img.img-responsive, img",
      "attr": "src",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Price",
      "selector": "div.price_box, span.price-new, span.text-base",
      "attr": "text",
      "filter": "number",
      "formula": ""
    },
    {
      "name": "Status",
      "selector": "div.text-right p",
      "attr": "text",
      "filter": "none",
      "formula": ""
    }
  ],
  "output": {
    "filename": "Keyboard-techland",
    "format": "csv"
  }
}