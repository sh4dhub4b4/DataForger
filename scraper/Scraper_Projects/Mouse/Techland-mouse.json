{
  "meta": {
    "Name": "Techland-mouse",
    "URL": "https://www.techlandbd.com/accessories/shop-computer-mouse"
  },
  "container": {
    "Selector": "div.products-list__item, article.products-list__item",
    "Type": "css"
  },
  "fields": [
    {
      "Name": "Title",
      "Selector": "a.product-title, h4 a, h2.v2-card-title",
      "Attr": "text",
      "Filter": "none"
    },
    {
      "Name": "Link",
      "Selector": "a.product-title, h4 a, a.block",
      "Attr": "href",
      "Filter": "none"
    },
    {
      "Name": "Image",
      "Selector": "img.img-responsive, img",
      "Attr": "src",
      "Filter": "none"
    },
    {
      "Name": "Price",
      "Selector": "div.price_box, span.text-base, span.price-new, div.text-red-600",
      "Attr": "text",
      "Filter": "number"
    },
    {
      "Name": "Status",
      "Selector": "div.bengali-text, div.text-right p",
      "Attr": "text",
      "Filter": "none"
    }
  ],
  "pagination": {
    "Type": "page_loop",
    "Selector": "",
    "Limit": 31
  },
  "output": {
    "Filename": "Techland-mouse",
    "Format": "csv"
  }
}