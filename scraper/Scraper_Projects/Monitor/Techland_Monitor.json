{
  "meta": {
    "name": "Techland_Monitor",
    "url": "https://www.techlandbd.com/monitor-and-display"
  },
  "container": {
    "selector": "div.products-list__item",
    "type": "css"
  },
  "pagination": {
    "type": "page_loop",
    "selector": "page",
    "limit": 1
  },
  "fields": [
    {
      "name": "Title",
      "selector": "a.product-title, h4.title a, h2.v2-card-title",
      "attr": "text",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Link",
      "selector": "a.product-title, h4.title a, a.block",
      "attr": "href",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Image",
      "selector": "img.img-responsive, img",
      "attr": "src",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Price",
      "selector": "div.price_box, span.price-new, div.text-red-600",
      "attr": "text",
      "filter": "number",
      "formula": ""
    },
    {
      "name": "Status",
      "selector": "div.bengali-text",
      "attr": "text",
      "filter": "custom",
      "formula": "trim | if_num('In Stock','In Stock')"
    }
  ],
  "output": {
    "filename": "Monitor-techland",
    "format": "csv"
  }
}