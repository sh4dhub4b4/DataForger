{
  "meta": {
    "name": "Idealo Bestseller Scraper",
    "url": "https://www.idealo.de/preisvergleich/SubProductCategory/14733.html"
  },
  "container": {
    "selector": "div[class*='bestsellerTile']",
    "type": "css"
  },
  "pagination": {
    "type": "none",
    "selector": "",
    "limit": 2
  },
  "fields": [
    {
      "name": "Product_Title",
      "selector": "div[class*='title']",
      "attr": "text",
      "filter": "custom",
      "formula": "normalize | trim"
    },
    {
      "name": "Product_URL",
      "selector": "a[class*='productLink']",
      "attr": "href",
      "filter": "url",
      "formula": ""
    },
    {
      "name": "Lowest_Price",
      "selector": "span[class*='price__currency']",
      "attr": "text",
      "filter": "custom",
      "formula": "remove('€') | replace('.', '') | replace(',', '.') | trim"
    },
    {
      "name": "Image_URL",
      "selector": "div[class*='imageArea'] img",
      "attr": "src",
      "filter": "url",
      "formula": ""
    }
  ],
  "output": {
    "filename": "Idealo Bestseller Scraper",
    "format": "csv"
  }
}