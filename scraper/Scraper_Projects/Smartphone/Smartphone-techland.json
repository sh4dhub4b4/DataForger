{
  "meta": {
    "name": "Smartphone-techland",
    "url": "https://www.techlandbd.com/smartphone-and-tablet/smartphone"
  },
  "container": {
    "selector": "article.products-list__item",
    "type": "css"
  },
  "pagination": {
    "type": "page_loop",
    "selector": "",
    "limit": 5
  },
  "fields": [
    {
      "name": "Title",
      "selector": "h4 a",
      "attr": "text",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Link",
      "selector": "h4 a",
      "attr": "href",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Image",
      "selector": "img",
      "attr": "src",
      "filter": "none",
      "formula": ""
    },
    {
      "name": "Price",
      "selector": "span.text-base",
      "attr": "text",
      "filter": "number",
      "formula": ""
    },
    {
      "name": "Status",
      "selector": "div.text-right p",
      "attr": "text",
      "filter": "none",
      "formula": ""
    }
  ],
  "output": {
    "filename": "Smartphone-techland",
    "format": "csv"
  }
}